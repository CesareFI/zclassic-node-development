+static int case_receipt_invocation_boundaries(void)
+{
+    int failures = 0;
+    const int64_t lower = INT64_MIN / 10;
+    const int64_t upper = INT64_MAX / 10;
+    const struct {
+        const char *name;
+        int64_t ordinal;
+        int64_t elapsed_ms;
+    } cases[] = {
+        {"L-1 is an invalid negative ordinal", lower - 1, ENGINE_RECEIPT_UNREPORTED},
+        {"L is an invalid negative ordinal", lower, ENGINE_RECEIPT_UNREPORTED},
+        {"L+1 is an invalid negative ordinal", lower + 1, ENGINE_RECEIPT_UNREPORTED},
+        {"U-1 has an exact duration", upper - 1, (upper - 1) * 10},
+        {"U has an exact duration", upper, upper * 10},
+        {"U+1 saturates its positive duration", upper + 1, INT64_MAX},
+        {"INT64_MIN has no valid fixture duration", INT64_MIN, ENGINE_RECEIPT_UNREPORTED},
+        {"INT64_MAX saturates its positive duration", INT64_MAX, INT64_MAX},
+        {"-1 has no valid fixture duration", -1, ENGINE_RECEIPT_UNREPORTED},
+        {"zero retains its zero-duration control", 0, 0},
+        {"ordinary positive ordinal has an exact duration", 7, 70},
+    };
+    for (size_t i = 0; i < sizeof(cases) / sizeof(cases[0]); i++) {
+        struct engine_receipt_invocation call = receipt_invocation(
+            cases[i].ordinal, "turn", "ok", 0, 0, 0, 0, 0, 0);
+        EN_CHECK(cases[i].name, call.elapsed_ms == cases[i].elapsed_ms);
+        EN_CHECK("fixture preserves the supplied ordinal", call.ordinal == cases[i].ordinal);
+    }
+    return failures;
+}
+
