 6 files changed, 37 insertions(+), 18 deletions(-)

diff --git a/contexts/commons/modules/vcs/src/package_recipe.c b/contexts/commons/modules/vcs/src/package_recipe.c
index c8974a2dc3..3bc87a154b 100644
--- a/contexts/commons/modules/vcs/src/package_recipe.c
+++ b/contexts/commons/modules/vcs/src/package_recipe.c
@@ -227,13 +227,14 @@ static bool recipe_strings_insert(struct vcs_package_recipe_strings *list,
         list->items = nitems;
         list->cap = ncap;
     }
-    char *copy = zcl_malloc(strlen(entry) + 1, "vcs_recipe_entry");
+    size_t copy_size = strlen(entry) + 1;
+    char *copy = zcl_malloc(copy_size, "vcs_recipe_entry");
     if (!copy) {
         if (err_out)
             *err_out = VCS_PACKAGE_RECIPE_ERR_ALLOC;
         return false;
     }
-    strcpy(copy, entry);
+    memcpy(copy, entry, copy_size);
     memmove(list->items + lo + 1, list->items + lo,
             (list->count - lo) * sizeof(*list->items));
     list->items[lo] = copy;
diff --git a/contexts/commons/packages/zlru/tests/test_zlru.c b/contexts/commons/packages/zlru/tests/test_zlru.c
index c674b50369..73c0a197fd 100644
--- a/contexts/commons/packages/zlru/tests/test_zlru.c
+++ b/contexts/commons/packages/zlru/tests/test_zlru.c
@@ -141,11 +141,21 @@ static void test_capacity_one(void) {
   zlru_destroy(c);
 }
 
+struct zlru_key_sink {
+  char *text;
+  size_t cap;
+};
+
 static bool collect_key(void *ctx, const char *key, void *value) {
   (void)value;
-  strcat(ctx, key);
-  strcat(ctx, " ");
-  return true;
+  struct zlru_key_sink *sink = ctx;
+  size_t used = strlen(sink->text);
+  CHECK(used < sink->cap);
+  if (used >= sink->cap) return false;
+  /* Three one-byte keys and spaces need seven bytes including the NUL. */
+  int n = snprintf(sink->text + used, sink->cap - used, "%s ", key);
+  CHECK(n >= 0 && (size_t)n < sink->cap - used);
+  return n >= 0 && (size_t)n < sink->cap - used;
 }
 
 static void test_visit_order(void) {
@@ -157,11 +167,12 @@ static void test_visit_order(void) {
   zlru_get(c, "a"); /* promote a: order b? no: c? order is b? recompute */
   /* MRU order now: a c b */
   char acc[64] = "";
-  zlru_visit_mru_first(c, collect_key, acc);
+  struct zlru_key_sink sink = {acc, sizeof(acc)};
+  zlru_visit_mru_first(c, collect_key, &sink);
   CHECK(!strcmp(acc, "a c b "));
   /* The visit must not promote: same order again. */
   memset(acc, 0, sizeof(acc));
-  zlru_visit_mru_first(c, collect_key, acc);
+  zlru_visit_mru_first(c, collect_key, &sink);
   CHECK(!strcmp(acc, "a c b "));
   zlru_destroy(c);
 }
diff --git a/contexts/commons/packages/ztemplate/tests/test_ztemplate.c b/contexts/commons/packages/ztemplate/tests/test_ztemplate.c
index 0f41319c2c..bcc18a5c39 100644
--- a/contexts/commons/packages/ztemplate/tests/test_ztemplate.c
+++ b/contexts/commons/packages/ztemplate/tests/test_ztemplate.c
@@ -239,8 +239,13 @@ static void test_differential(void)
         char t[256];
         t[0] = '\0';
         size_t parts = rng_next() % 8;
-        for (size_t i = 0; i < parts; i++)
-            strcat(t, frags[rng_next() % 10]);
+        /* At most seven fragments of eleven bytes: 78 including the NUL. */
+        for (size_t i = 0; i < parts; i++) {
+            size_t used = strlen(t);
+            int n = snprintf(t + used, sizeof(t) - used,
+                             "%s", frags[rng_next() % 10]);
+            CHECK(n >= 0 && (size_t)n < sizeof(t) - used);
+        }
         ztemplate *tp = ztemplate_parse(t, strlen(t), NULL);
         CHECK(tp != NULL);
         char got[1024], want[1024];
diff --git a/contexts/commons/packages/ztoml/tests/test_ztoml.c b/contexts/commons/packages/ztoml/tests/test_ztoml.c
index b19969c5bd..b5d7f146bf 100644
