+++ b/contexts/commons/packages/ztoml/tests/test_ztoml.c
@@ -255,8 +255,14 @@ static void test_err(void) {
   /* Depth bound. */
   {
     char doc[64] = "k = ";
+    static_assert(ZTOML_MAX_DEPTH + 2 <= sizeof(doc) - sizeof("k = "),
+                  "depth fixture must fit without truncation");
     size_t i;
-    for (i = 0; i < ZTOML_MAX_DEPTH + 2; i++) strcat(doc, "[");
+    for (i = 0; i < ZTOML_MAX_DEPTH + 2; i++) {
+      size_t used = strlen(doc);
+      CHECK(snprintf(doc + used, sizeof(doc) - used, "[") == 1);
+    }
+    CHECK(strlen(doc) == 4 + ZTOML_MAX_DEPTH + 2);
     evlog log;
     CHECK(parse_all(doc, &log) == ZTOML_ERR_RANGE);
   }
