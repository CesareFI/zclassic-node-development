 .../commons/packages/zlru/tests/test_zlru.c   | 21 ++++++++++++++-----
 .../packages/ztemplate/tests/test_ztemplate.c |  9 ++++++--
 .../commons/packages/ztoml/tests/test_ztoml.c |  8 ++++++-
