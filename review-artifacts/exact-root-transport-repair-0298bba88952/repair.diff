+static void zwn_exact_root_manifest_reply(
+    struct zwn_exact_root_trace *t, const struct vcs_swarm_frame_result *ev)
+{
+    struct vcs_package_swarm_message reply;
+    t->reply_seen = vcs_package_swarm_parse(ev->reply, ev->reply_len, &reply) &&
+        reply.type == VCS_PACKAGE_SWARM_DATA &&
+        vcs_package_swarm_verify_data(t->manifest, &t->want, &reply.body.data);
+    if (!t->reply_seen)
+        t->failure = "provider returned uncorrelated manifest DATA";
+}
+
+static void zwn_exact_root_want(
+    struct zwn_exact_root_trace *t, const struct p2p_node *node,
+    const struct vcs_package_swarm_object *want,
+    const struct vcs_swarm_frame_result *ev)
+{
+    if ((uint64_t)node->id != t->requester_peer ||
+        memcmp(want->package_root, t->root, 32) != 0) {
+        t->failure = "WANT reached the wrong peer or root";
+        return;
+    }
+    bool manifest = want->object_kind == VCS_PACKAGE_SWARM_OBJECT_MANIFEST;
+    if (manifest) {
+        if (t->want_seen) {
+            t->failure = "repeated manifest WANT";
+            return;
+        }
+        t->want = *want;
+        t->want_seen = true;
+    }
+    if (ev->rule || ev->penalty != VCS_SWARM_PENALTY_NONE ||
+        ev->disconnect_peer || !ev->reply || !ev->reply_len) {
+        t->failure = ev->rule ? ev->rule : "provider refused DATA";
+    } else if (manifest) {
+        zwn_exact_root_manifest_reply(t, ev);
+    }
+}
+
+static void zwn_exact_root_data(
+    struct zwn_exact_root_trace *t, const struct p2p_node *node,
+    const struct vcs_package_swarm_data *data,
+    const struct vcs_swarm_frame_result *ev)
+{
+    if ((uint64_t)node->id != t->provider_peer ||
+        memcmp(data->object.package_root, t->root, 32) != 0) {
+        t->failure = "DATA reached the wrong peer or root";
+    } else if (ev->rule || ev->penalty != VCS_SWARM_PENALTY_NONE ||
+               ev->disconnect_peer) {
+        t->failure = ev->rule ? ev->rule : "consumer refused DATA";
+    } else if (data->object.object_kind == VCS_PACKAGE_SWARM_OBJECT_MANIFEST) {
+        if (!t->want_seen || !t->reply_seen || t->data_seen ||
+            !vcs_package_swarm_verify_data(t->manifest, &t->want, data))
+            t->failure = "consumer received uncorrelated manifest DATA";
+        else
+            t->data_seen = true;
+    }
+}
