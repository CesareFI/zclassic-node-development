+static bool unavailable_drive_is_refused(const wchar_t *base)
+{
+    DWORD drives = GetLogicalDrives();
+    if (!drives) return false;
+    for (unsigned i = 0; i < 26; ++i) {
+        if ((drives & (1ul << i)) != 0) continue;
+        wchar_t path[] = L"A:\\not-present";
+        path[0] = (wchar_t)(L'A' + i);
+        char existing[32768];
+        bool absent = true;
+        bool refused = SetEnvironmentVariableW(L"ZCL_STATE_ROOT", path) &&
+                       !platform_state_root_lookup(existing, sizeof(existing), &absent) &&
+                       !absent;
+        return SetEnvironmentVariableW(L"ZCL_STATE_ROOT", base) && refused;
+    }
+    return true; /* All drive letters are in use. */
+}
