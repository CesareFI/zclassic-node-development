+/* Check each prefix before classifying a missing child. The drive or UNC
+ * share must itself be reachable before a child can be reported absent. */
+static bool state_root_windows_base_existing(char *base, bool *absent)
+{
+    char *part = base;
+    if (platform_path_drive_absolute(base)) {
+        part += 3;
+    } else if (platform_path_unc_absolute(base)) {
+        part += 2 + strcspn(base + 2, "/\\");
+        part += 1 + strcspn(part + 1, "/\\");
+    }
+    if (part != base) {
+        char saved = *part;
+        *part = '\0';
+        bool reachable = state_root_component_existing(base, NULL);
+        *part = saved;
+        if (!reachable) return false;
+    }
+    while (*part) {
+        part += strspn(part, "/\\");
+        if (!*part) break;
+        part += strcspn(part, "/\\");
+        char saved = *part;
+        *part = '\0';
+        bool ok = state_root_component_existing(base, absent);
+        *part = saved;
+        if (!ok) return false;
+    }
+    return true;
+}
+
+static bool state_root_windows_base(char base[32768])
+{
+    wchar_t env_base[32768];
+    DWORD length = GetEnvironmentVariableW(L"ZCL_STATE_ROOT", env_base, 32768);
+    if (length >= 32768) return false;
+    if (!length) return state_root_base_from_known_folder(base);
+    return WideCharToMultiByte(CP_UTF8, WC_ERR_INVALID_CHARS, env_base, -1,
+                               base, 32768, NULL, NULL) > 1;
+}
+
+static bool state_root_resolve(char *out, size_t cap, bool create, bool application,
+                               bool *absent)
+{
+    char base[32768], z23[32768];
