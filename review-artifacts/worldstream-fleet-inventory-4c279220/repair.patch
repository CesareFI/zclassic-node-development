+/* Exercise the registered inventory leaf and its typed refusal. */
+static bool fe_inventory_outcome(const char *code)
+{
+    struct zcl_command_reply reply;
+    char why[160];
+    if (!fe_machines_call("{}", &reply, why, sizeof(why))) return false;
+    bool ok = strcmp(reply.error.code, code) == 0;
+    if (!code[0])
+        ok = ok && reply.exit_code == ZCL_COMMAND_EXIT_OK &&
+             json_get_int(json_get(&reply.data, "total")) == 0 &&
+             !json_get_bool(json_get(&reply.data, "joined"));
+    else
+        ok = ok && reply.exit_code != ZCL_COMMAND_EXIT_OK;
+    zcl_command_reply_free(&reply);
+    return ok;
+}
+
+static int test_fe_machines_absent(void)
+{
+    int failures = 0;
+    struct stat st;
+    TEST("fleet machines keeps missing and empty state unchanged on repeated reads") {
+        fe_isolate("machines-absent");
+        for (int i = 0; i < 2; ++i) {
+            ASSERT(fe_inventory_outcome(""));
+            ASSERT(lstat(g_fe_state, &st) != 0 && errno == ENOENT);
+        }
+        ASSERT(mkdir(g_fe_state, 0700) == 0);
+        ASSERT(fe_inventory_outcome(""));
+        ASSERT(fe_inventory_outcome(""));
+        ASSERT(rmdir(g_fe_state) == 0); /* still empty */
+        PASS();
+    } _test_next:;
+    return failures;
+}
+
+static int test_fe_machines_invalid_state(void)
+{
+    int failures = 0;
+    char path[FLEET_ENROL_PATH_MAX];
+    FILE *file;
+    TEST("fleet machines distinguishes invalid private state and leaves from absence") {
+        fe_isolate("machines-invalid");
+        ASSERT(mkdir(g_fe_home, 0700) == 0);
+        ASSERT(symlink(g_fe_home, g_fe_state) == 0);
+        ASSERT(fe_inventory_outcome("FLEET_OPERATOR_UNREADABLE"));
+        ASSERT(unlink(g_fe_state) == 0);
+        ASSERT(rmdir(g_fe_home) == 0);
+        file = fopen(g_fe_state, "wb");
+        ASSERT(file && fclose(file) == 0);
+        ASSERT(fe_inventory_outcome("FLEET_OPERATOR_UNREADABLE"));
+        ASSERT(unlink(g_fe_state) == 0);
+        ASSERT(fleet_enrol_state_path("box.ed25519", path, sizeof(path)));
+        ASSERT(symlink("missing-seed", path) == 0);
+        ASSERT(fe_inventory_outcome("FLEET_KEY_UNAVAILABLE"));
+        ASSERT(unlink(path) == 0);
+        file = fopen(path, "wb");
+        ASSERT(file && fclose(file) == 0);
+        ASSERT(fe_inventory_outcome("FLEET_KEY_UNAVAILABLE"));
+        ASSERT(unlink(path) == 0);
+        ASSERT(fleet_enrol_state_path_existing("machines.roster", path, sizeof(path)));
+        ASSERT(symlink("missing-roster", path) == 0);
+        ASSERT(fe_inventory_outcome("FLEET_ROSTER_UNREADABLE"));
+        ASSERT(unlink(path) == 0);
+        ASSERT(fleet_enrol_state_path_existing("operator.pub", path, sizeof(path)));
+        file = fopen(path, "wb");
+        ASSERT(file && fclose(file) == 0);
+        ASSERT(fe_inventory_outcome("FLEET_OPERATOR_UNREADABLE"));
+        ASSERT(unlink(path) == 0);
+        char *leaf = strrchr(path, '/');
+        ASSERT(leaf != NULL);
+        *leaf = '\0';
+        ASSERT(chmod(path, 0755) == 0);
+        ASSERT(fe_inventory_outcome("FLEET_OPERATOR_UNREADABLE"));
+        ASSERT(chmod(path, 0700) == 0);
+        PASS();
+    } _test_next:;
+    return failures;
+}
