+/* A named provider must serve an unannounced exact root through zpkgswm,
+ * not merely connect or leave a fetch pending until its budget expires. */
+static int zwn_t_exact_root_transport(const struct chain_params *params)
+{
+    int failures = 0;
+    struct zwn_fixture fixture = {0};
+    struct zwn_node a, b;
+    struct zwn_link a_b, b_a;
+    struct zwn_pkg pkg = {0};
+    struct zwn_exact_root_trace trace = {0};
+    TEST("named peer: exact-root WANT and correlated DATA traverse the real "
+         "dispatcher without ANNOUNCE, then complete byte-identically") {
+        ASSERT(zwn_make_package(&pkg, 3, 0x61));
+        const struct zwn_node_spec nodes[] = {{&a, "era"}, {&b, "erb"}};
+        ASSERT(zwn_fixture_nodes(&fixture, params, nodes,
+                                 sizeof(nodes) / sizeof(nodes[0])));
+        ASSERT(zwn_store_package(a.store, &pkg));
+        ASSERT(vcs_package_store_pin(a.store, pkg.root, true) ==
+               VCS_PACKAGE_STORE_OK);
+        struct vcs_package_store_status status = {0};
+        ASSERT(vcs_package_store_package_status(a.store, pkg.root, &status));
+        ASSERT(status.complete && status.pinned);
+        ASSERT(zwn_store_matches(a.store, &pkg));
+        ASSERT(!vcs_package_store_package_status(b.store, pkg.root, &status) ||
+               !status.complete);
+
+        const struct zwn_link_spec links[] = {
+            {&a, &a_b, {10, 3, 0, 2}, "named-consumer"},
+            {&b, &b_a, {10, 3, 0, 1}, "named-provider"},
+        };
+        ASSERT(zwn_fixture_links(&fixture, links,
+                                 sizeof(links) / sizeof(links[0])));
+        memcpy(trace.root, pkg.root, 32);
+        trace.manifest = &pkg.manifest;
+        trace.requester_peer = (uint64_t)a_b.node->id;
+        trace.provider_peer = (uint64_t)b_a.node->id;
+        a.exact_root_trace = b.exact_root_trace = &trace;
+        ASSERT(zwn_meet_side_quiet(&a, &a_b));
+        ASSERT(zwn_meet_side_quiet(&b, &b_a));
+        ASSERT(vcs_swarm_engine_peer_known(a.engine, trace.requester_peer));
+        ASSERT(vcs_swarm_engine_peer_known(b.engine, trace.provider_peer));
+        ASSERT(a_b.sentinel->next == NULL && b_a.sentinel->next == NULL);
+        ASSERT(zwn_pump(&a_b, &b_a, params->pchMessageStart));
+        ASSERT(zwn_pump(&b_a, &a_b, params->pchMessageStart));
+        ASSERT(!trace.want_seen && !trace.reply_seen && !trace.data_seen &&
+               trace.announces == 0 && trace.failure == NULL);
+
+        /* Existing helper bounds this to 600 rounds of the real wire pump. */
+        bool complete = zwn_fetch_package_from_provider(
+            &b, pkg.root, &a_b, &b_a, params->pchMessageStart);
+        char root_hex[65];
+        zcl_hex_encode(pkg.root, 32, root_hex);
+        printf("[exact-root-transport] root=%s provider_peer=%llu "
+               "requester_peer=%llu request=%llu want=%d reply=%d data=%d "
+               "announces=%u complete=%d failure=%s\n", root_hex,
+               (unsigned long long)trace.provider_peer,
+               (unsigned long long)trace.requester_peer,
+               (unsigned long long)trace.want.request_id, trace.want_seen,
+               trace.reply_seen, trace.data_seen, trace.announces, complete,
+               trace.failure ? trace.failure : "none");
+        ASSERT(trace.failure == NULL); /* refusal is a failure, not a timeout */
+        ASSERT(trace.want_seen && trace.want.request_id != 0);
+        ASSERT(trace.reply_seen && trace.data_seen);
+        ASSERT(trace.announces == 0);
+        ASSERT(complete);
+        ASSERT(vcs_package_store_package_status(b.store, pkg.root, &status));
+        ASSERT(status.complete && status.total_bytes == pkg.total_bytes);
+        ASSERT(zwn_store_matches(b.store, &pkg));
+        ASSERT(vcs_package_store_package_status(a.store, pkg.root, &status));
+        ASSERT(status.complete && status.pinned);
+        PASS();
+    } _test_next:
+    zwn_fixture_cleanup(&fixture);
+    zwn_free_package(&pkg);
+    return failures;
+}
