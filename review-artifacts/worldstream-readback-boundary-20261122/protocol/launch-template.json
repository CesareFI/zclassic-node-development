{
  "model": "gpt-6.1-terra",
  "cwd": "${CASE}",
  "command": [
    "${RUNTIME}/codex",
    "exec",
    "--ephemeral",
    "--model",
    "gpt-6.1-terra",
    "--skip-git-repo-check",
    "--json",
    "-C",
    "${CASE}",
    "-c",
    "default_permissions=\"fixture\"",
    "-c",
    "permissions.fixture.filesystem={\":minimal\"=\"read\",\":workspace_roots\"=\"read\",\"${RUNTIME}\"=\"read\"}",
    "-c",
    "permissions.fixture.network.enabled=false",
    "-c",
    "approval_policy=\"never\"",
    "-c",
    "allow_login_shell=false",
    "-c",
    "web_search=\"disabled\"",
    "-c",
    "features.multi_agent=false",
    "-c",
    "features.plugins=false",
    "-c",
    "features.apps=false",
    "-c",
    "model_reasoning_effort=\"low\"",
    "-c",
    "shell_environment_policy.inherit=\"none\"",
    "-c",
    "shell_environment_policy.set={HOME=\"${CASE}\",PATH=\"/usr/bin:/bin\",GIT_ALLOW_PROTOCOL=\"file\",GIT_CONFIG_NOSYSTEM=\"1\",LC_ALL=\"C\",GIT_TERMINAL_PROMPT=\"0\"}",
    "-"
  ],
  "cli_version": "0.161.0",
  "cli_sha256": "9a820c17865fa825d04db416818679a9d63bd72e50835c396f496e5684626c9c"
