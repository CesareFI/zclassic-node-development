@@ -41,12 +44,75 @@
  * sits one below, so the first minted block is at this height. */
 #define SIM_FIRST_MINT_HEIGHT 100
 
+/* Only the header root differs from the accepted block. Rebuild its parent
+ * in a disposable sim: connect_block can write its coins view before refusing
+ * the root. The original simulation must remain usable for the next height. */
+static bool sa_zero_root_refused(struct block *block, int height, int activation)
+{
+    struct simnet parent;
+    if (!simnet_init(&parent))
+        return false;
+    simnet_activate_sapling_at(&parent, activation);
+
+    bool refused = false;
+    if (simnet_mint_to_height(&parent, height - 1)) {
+        struct block_index index;
+        block_index_init(&index);
+        index.nHeight = height;
+        index.pprev = &parent.tip;
+        struct validation_state state;
+        validation_state_init(&state);
+        uint256_set_null(&block->header.hashFinalSaplingRoot);
+        refused = !connect_block(block, &state, &index, &parent.view,
+                                 &parent.params, false) &&
+                  strcmp(state.reject_reason, "bad-sapling-root-zeroed") == 0;
+    }
+    simnet_free(&parent);
+    return refused;
+}
+
+static int sa_cross_activation(const struct uint256 *empty_root)
+{
+    int failures = 0;
+    const int activation = SIM_FIRST_MINT_HEIGHT + 1;
+    struct simnet sim;
+    if (!simnet_init(&sim))
+        return 1;
+    simnet_activate_sapling_at(&sim, activation);
+    const struct uint256 zero = {0};
+    for (int height = activation - 1; height <= activation + 1; ++height) {
+        struct block block;
+        block_init(&block);
+        int captured_height;
+        bool minted = simnet_mint_txs_capture(&sim, NULL, 0, &block,
+                                              &captured_height);
+        printf("height %d: ", height);
+        SA_CHECK("connected block reached expected tip",
+                 minted && captured_height == height && simnet_tip_height(&sim) == height);
+        if (minted) {
+            const struct uint256 *expected = height < activation ? &zero : empty_root;
+            SA_CHECK("accepted header has the expected Sapling root",
+                     uint256_cmp(&block.header.hashFinalSaplingRoot, expected) == 0);
+            if (height >= activation)
+                SA_CHECK("zero-root sibling rejected with bad-sapling-root-zeroed",
+                         sa_zero_root_refused(&block, height, activation));
+        }
+        block_free(&block);
+        if (!minted)
+            break;
+    }
+    simnet_free(&sim);
+    return failures;
+}
+
