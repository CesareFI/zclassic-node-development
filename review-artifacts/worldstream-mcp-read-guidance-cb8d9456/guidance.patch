     return strstr(m->line, needle) != NULL;
 }
 
+/* Find the tool description within the parsed tools/list response. */
+static const char *ms_run_description(const struct json_value *result)
+{
+    const struct json_value *tools = json_get(result, "tools");
+    for (size_t i = 0; i < json_size(tools); i++) {
+        const struct json_value *tool = json_at(tools, i);
+        const char *name = json_get_str(json_get(tool, "name"));
+        if (name && strcmp(name, "z23_run") == 0)
+            return json_get_str(json_get(tool, "description"));
+    }
+    return NULL;
+}
+
+static bool ms_guidance_terms(const char *text)
+{
+    static const char *const terms[] = {
+        "wallet risk", "core-recovery risk", "owner authority",
+        "always refused", "Other reads run directly", "wallet data",
+        "--wallet-reads", "READ_REFUSED_WALLET_DATA", "z23_describe"
+    };
+    if (!text) return false;
+    for (size_t i = 0; i < sizeof(terms) / sizeof(terms[0]); i++)
+        if (!strstr(text, terms[i])) return false;
+    return true;
+}
+
+/* Check the actual instructions or z23_run description field. */
+static bool ms_read_guidance(const struct ms *m, bool tool_description)
+{
+    struct json_value root = {0};
+    if (!json_read(&root, m->line, strlen(m->line))) return false;
+    const struct json_value *result = json_get(&root, "result");
+    const char *text = tool_description ? ms_run_description(result) :
+        json_get_str(json_get(result, "instructions"));
+    bool ok = ms_guidance_terms(text);
+    json_free(&root);
+    return ok;
+}
+
 static const char ms_init_req[] =
     "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{"
     "\"protocolVersion\":\"2025-06-18\",\"capabilities\":{},\"clientInfo\":"
@@ -272,6 +311,7 @@ static int case_no_checkout_instructions(const char *home)
         ASSERT(ms_start(&m, args, home, err));
         ASSERT(ms_call(&m, ms_init_req));
