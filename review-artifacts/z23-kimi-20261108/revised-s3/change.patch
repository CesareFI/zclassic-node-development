+struct zlru_key_sink {
+  char *text;
+  size_t cap;
+};
+
 static bool collect_key(void *ctx, const char *key, void *value) {
   (void)value;
-  strcat(ctx, key);
-  strcat(ctx, " ");
+  struct zlru_key_sink *sink = ctx;
+  size_t used = strlen(sink->text);
+  /* Three one-byte keys and spaces need seven bytes including the NUL. */
+  (void)snprintf(sink->text + used, sink->cap - used, "%s ", key);
   return true;
 }
 
@@ -157,11 +164,12 @@ static void test_visit_order(void) {
   zlru_get(c, "a"); /* promote a: order b? no: c? order is b? recompute */
   /* MRU order now: a c b */
   char acc[64] = "";
-  zlru_visit_mru_first(c, collect_key, acc);
+  struct zlru_key_sink sink = {acc, sizeof(acc)};
+  zlru_visit_mru_first(c, collect_key, &sink);
   CHECK(!strcmp(acc, "a c b "));
   /* The visit must not promote: same order again. */
   memset(acc, 0, sizeof(acc));
-  zlru_visit_mru_first(c, collect_key, acc);
+  zlru_visit_mru_first(c, collect_key, &sink);
   CHECK(!strcmp(acc, "a c b "));
