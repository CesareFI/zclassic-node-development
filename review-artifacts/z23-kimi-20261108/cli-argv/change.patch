+static int cli_argv_check_resume_limits(const struct engine_vendor *grok, struct engine_cli_inputs in, struct engine_cli_inputs base_resume, struct engine_cli_inputs resumed, size_t base_n, size_t resumed_n, const char *argv[ENGINE_CLI_ARGV_MAX])
