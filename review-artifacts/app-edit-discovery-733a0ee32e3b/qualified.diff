+    zcl_command_reply_init(&reply, "zcl.command_schema.v1");
+    struct zcl_command_request request = { .input = &input };
+    bool ok = json_push_kv_str(&input, "path", "app.edit");
+    if (ok)
+        zcl_native_handle_discover_schema(&request, &reply);
+    const struct json_value *fields = json_get(json_get(&reply.data, "input_transport"), "fields");
+    const struct json_value *content = json_get(fields, "content");
+    ok = ok && reply.exit_code == ZCL_COMMAND_EXIT_OK &&
+        api_schema_int_is(content, "min_bytes", 0) &&
+        api_schema_int_is(content, "max_bytes", ZCL_COMMAND_APP_EDIT_CONTENT_MAX) &&
+        !json_get(content, "required_by_transport") &&
+        api_schema_int_is(json_get(fields, "path"), "min_bytes", 1);
+    zcl_command_reply_free(&reply);
+    json_free(&input);
+    return ok;
+}
